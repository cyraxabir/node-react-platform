# ============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# This template shows all available configuration options.
# ============================================================================

# Database Configuration
# ============================================================================
# Local development typically uses simple credentials
# Production uses strong passwords and separate read replicas
DB_USER=appuser
DB_PASSWORD=changeme
DB_NAME=appdb
DB_PORT=5432

# Backend Service Configuration
# ============================================================================
# Application port (must match docker-compose.yml exposure)
PORT=3000

# Node environment: development, staging, or production
NODE_ENV=production

# Database Connection URLs
# For local dev, both read and write point to the same instance
# In production, DB_READ_URL can point to a replica
DB_WRITE_URL=postgres://appuser:password@postgres:5432/appdb
DB_READ_URL=postgres://appuser:password@postgres:5432/appdb

# Redis Configuration
# ============================================================================
# Format: redis://[hostname]:[port]
# Docker Compose uses service name as hostname
REDIS_URL=redis://redis:6379

# Search/Analytics (Optional)
# ============================================================================
# Elasticsearch endpoint for full-text search
SEARCH_URL=http://elasticsearch:9200

# Frontend Configuration
# ============================================================================
# API base URL frontend uses to reach backend
# In browser, http://localhost:3000 resolves to the backend service
VITE_API_URL=http://localhost:3000
