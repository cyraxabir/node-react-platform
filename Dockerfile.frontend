# syntax=docker/dockerfile:1.4
# MINIMAL React frontend - Absolute bare nginx
# Multi-stage: builder (build only) + runtime (nginx:alpine ONLY, no bloat)
# Target: ~30MB final or lower

# Stage 1: Build
FROM node:22-alpine AS builder

WORKDIR /build
COPY frontend/package*.json ./
COPY frontend/index.html .
COPY frontend/vite.config.js .
COPY frontend/src ./src

RUN npm ci --no-audit && \
    npm run build && \
    npm cache clean --force && \
    rm -rf node_modules src package*.json vite.config.js index.html && \
    find dist -type f -name "*.map" -delete && \
    find dist -type f -name "*.json" -not -name "package.json" -delete


# Stage 2: Runtime - Use plain nginx:alpine, remove only redundant files
FROM nginx:alpine

# Remove only true unnecessary files
RUN rm -f /etc/nginx/conf.d/default.conf

# Copy nginx config
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Copy static dist files
COPY --from=builder /build/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
